# Optional overrides for docker compose. Copy to .env and edit; every value has a working default.
# These defaults are for local demos only. Use real secrets anywhere else.

# Port the app is published on (http://localhost:8080)
APP_PORT=8080
# Port PostgreSQL is published on, for running the API with `dotnet run` against `docker compose up -d db`
DB_PORT=5433

POSTGRES_PASSWORD=dispute_portal
# At least 32 characters
JWT_SIGNING_KEY=local-demo-signing-key-change-me-0123456789abcdef
# Password for all seeded demo users
DEMO_PASSWORD=Demo@1234
