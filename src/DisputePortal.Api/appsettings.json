{
  "ConnectionStrings": {
    "DisputePortal": ""
  },
  "Jwt": {
    "Issuer": "dispute-portal",
    "Audience": "dispute-portal-web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 30
  },
  "Disputes": {
    "DisputeWindowDays": 120
  },
  "Database": {
    "MigrateOnStartup": false,
    "Seed": {
      "Enabled": false
    }
  },
  "Api": {
    "EnableDocs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
