root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
# Library code: ConfigureAwait is unnecessary in ASP.NET Core (no sync context).
dotnet_diagnostic.CA2007.severity = none
# ToLower()/Contains() inside EF Core LINQ queries are translated to SQL (lower()/LIKE), so the
# culture/StringComparison overloads these rules suggest are not translatable.
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1862.severity = none
# Test method names use underscores.
dotnet_diagnostic.CA1707.severity = none

[*.md]
trim_trailing_whitespace = false

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
